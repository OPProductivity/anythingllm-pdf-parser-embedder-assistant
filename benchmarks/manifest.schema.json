{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnythingLLM PDF assistant public benchmark manifest",
  "type": "object",
  "required": ["schema_version", "benchmark_set_id", "profile", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_set_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "profile": {"const": "ordinary-page-preserving-upload"},
    "documents": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "page_count", "size_mib", "ocr_risk"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^B[0-9]{2}$"},
          "page_count": {"type": "integer", "minimum": 1},
          "size_mib": {"type": "number", "exclusiveMinimum": 0},
          "ocr_risk": {"const": "low"}
        }
      }
    }
  },
  "additionalProperties": false
}
